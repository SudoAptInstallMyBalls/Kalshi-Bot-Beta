# Kalshi API
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
BOT_CONTROL_TOKEN=replace_with_a_long_random_local_secret

# Market Selection
SERIES_TICKER=KXBTC15M           # Series ticker (KXBTC15M for 15-min)
SLOT_DURATION=900                # Slot duration in seconds (900=15min)

# Strategy Thresholds
MIN_EDGE=10.0                    # Minimum edge % for Polymarket arbitrage
MIN_DIVERGENCE=15.0              # Minimum divergence % for directional (Binance spot) trades
TRADING_WINDOW=4                 # Only trade first N minutes of each 15-min market

# Position Sizing
MAX_POSITION_SIZE=5              # Maximum $ per trade
MAX_TOTAL_OPEN_POSITIONS=10      # Maximum concurrent positions
MAX_POSITIONS_PER_CONTRACT=1     # Maximum positions on same contract
USE_KELLY_SIZING=true            # Enable Kelly criterion sizing
KELLY_FRACTION=0.08              # Fraction of full Kelly; matches server defaults




# Server
PORT=3333                        # Mission Control dashboard port

# Session safety (percentages expressed as fractions)
SESSION_DRAWDOWN_REDUCE_PCT=0.10
SESSION_DRAWDOWN_PAUSE_PCT=0.20
SESSION_DRAWDOWN_PAUSE_MS=900000
MAX_EXECUTION_FAILURES=5
MIN_TRADING_BALANCE=5

# Local ML storage and validation
ML_FLUSH_INTERVAL_MS=500
ML_BUFFER_THRESHOLD=50
ML_CONTEXT_TTL_MS=20000
ML_MIN_TRAINING_SAMPLES=300
ML_UPSIZE_MIN_TRAINING_SAMPLES=1000
ML_BASELINE_BRIER=0.25

# Settlement-aware entries (default): require your authorized one-second BRTI feed.
# Missing/stale feed or incomplete warmup blocks new entries. Exits remain available.
SETTLEMENT_AWARE=true
# Optional override; default is BOT_DATA_DIR/settlement-index.sqlite (or data/settlement-index.sqlite).
# SETTLEMENT_INDEX_DB=C:/absolute/path/settlement-index.sqlite
